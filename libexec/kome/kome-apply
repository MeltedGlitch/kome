#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# kome apply — apply a look.

set -eu

KOME_ROOT=${KOME_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)}
export KOME_ROOT
# shellcheck source=lib/kome/common.sh
. "$KOME_ROOT/lib/kome/common.sh"
# shellcheck source=lib/kome/preset.sh
. "$KOME_ROOT/lib/kome/preset.sh"
# shellcheck source=lib/kome/units.sh
. "$KOME_ROOT/lib/kome/units.sh"

usage() {
	cat <<EOF
usage: kome apply [-n] [-v] [--partial] [preset]

Apply a look to the whole desktop. Without a preset, uses Preset= from
$KOME_CONF, else the active one.

  -n, --dry-run  show what would be applied, change nothing
  -v, --verbose  say what each unit does
  --partial      apply what is possible even if something is missing

Your desktop is saved first: 'kome restore previous' undoes this apply,
'kome restore original' brings back your desktop from before kome.
EOF
}

dry=
verbose=
partial=
preset=
while [ $# -gt 0 ]; do
	case $1 in
	-n | --dry-run) dry=1 ;;
	-v | --verbose) verbose=1 ;;
	--partial) partial=1 ;;
	-h | --help)
		usage
		exit "$EX_OK"
		;;
	-*) die "$EX_USAGE" "unknown option: $1" "run 'kome apply --help'" ;;
	*)
		[ -z "$preset" ] || die "$EX_USAGE" "only one preset can be applied" "run 'kome apply <preset>'"
		preset=$1
		;;
	esac
	shift
done

say() { [ -z "$verbose" ] || printf 'kome: %s\n' "$*" >&2; }

preset=$(preset_pick "$preset") ||
	die "$EX_USAGE" "no preset given" "run 'kome list' to see the presets, then 'kome apply <preset>'"
preset_export "$preset" || exit

# 1. Check every enabled unit before touching anything.
apply_units=
missing=
notices=
for u in $(units_all); do
	name=$(unit_name "$u")
	if ! unit_enabled "$u"; then
		say "$name: off (turn it on with '$name=on' under [Units] in kome.conf)"
		continue
	fi
	unit_check "$u"
	case $check_status in
	"$CHECK_READY") apply_units="$apply_units $u" ;;
	"$CHECK_ABSENT") say "$name: not installed here, skipped" ;;
	"$CHECK_MISSING") missing="$missing$(printf '%s\n' "$check_out" | sed "s/^/  /; s/\$/  ($name)/")
" ;;
	"$CHECK_OPTIONAL") notices="${notices}install $(ingredient_names "$check_out") to also theme $(unit_label "$u")
" ;;
	*) die "$EX_UNAVAILABLE" "'$name' cannot run here" "run 'kome doctor' to see why" ;;
	esac
done

if [ -n "$missing" ] && [ -z "$partial" ]; then
	err "'$preset' needs things that are not installed:"
	printf '%s' "$missing" >&2
	hint "run 'kome deps $preset' to see how to install them,"
	hint "or 'kome apply --partial $preset' to apply everything else"
	exit "$EX_UNAVAILABLE"
fi

if [ -n "$dry" ]; then
	printf 'preset: %s (%s)\n' "$preset" "${KOME_NAME:-$preset}"
	for u in $apply_units; do printf 'apply: %s\n' "$(unit_name "$u")"; done
	env | grep '^KOME_' | grep -v '^KOME_ROOT=' | sort
	exit "$EX_OK"
fi

# 2. Save the desktop, then apply.
lock_take
if [ -d "$KOME_SNAP_DIR/original" ]; then
	snapshot_complete original
else
	snapshot_take original
fi
if [ -f "$KOME_STATE_DIR/failed" ]; then
	warn "the last apply failed, so 'previous' still holds the last good look"
else
	snapshot_take previous
fi

# What each unit looks like right after applying: `kome status` compares
# against it to find what was changed by hand since.
applied=$KOME_STATE_DIR/applied
rm -rf "${applied:?}.tmp"
mkdir -p "$applied.tmp"

for u in $apply_units; do
	name=$(unit_name "$u")
	before=$("$u/unit" current 2>/dev/null || :)
	unit_touched "$u"
	if ! "$u/unit" apply; then
		: >"$KOME_STATE_DIR/failed"
		err "'$name' failed; the desktop may be half-applied"
		hint "run 'kome restore previous' to go back"
		exit "$EX_SOFTWARE"
	fi
	"$u/unit" current >"$applied.tmp/$name" 2>/dev/null || rm -f "$applied.tmp/$name"
	if [ "$before" != "$(cat "$applied.tmp/$name" 2>/dev/null)" ]; then
		effect_note "$u"
		say "$name: applied"
	else
		say "$name: already as wanted"
	fi
done
rm -rf "${applied:?}"
mv "$applied.tmp" "$applied"

printf '%s\n' "$preset" >"$KOME_STATE_DIR/active"
rm -f "$KOME_STATE_DIR/failed"
effects_report
if [ -n "$notices" ]; then
	printf '%s' "$notices" | sed 's/^/kome: /' >&2
	hint "run 'kome deps $preset' to see how to install them"
fi
