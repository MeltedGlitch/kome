# Generated by kome from the "{{name}}" palette — do not edit this file.
# To customise it, copy this template to
#   ~/.config/kome/templates/colors/kde.colors.in
# and edit the copy. Each double-brace placeholder is a palette role (see
# the palette files); mix/lighten/darken derive shades from them.

[ColorEffects:Disabled]
Color={{base:rgb}}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{base:rgb}}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

# Push buttons, combo boxes.
[Colors:Button]
BackgroundAlternate={{surface1:rgb}}
BackgroundNormal={{surface0:rgb}}
DecorationFocus={{accent:rgb}}
DecorationHover={{accent:rgb}}
ForegroundActive={{accent:rgb}}
ForegroundInactive={{subtext0:rgb}}
ForegroundLink={{blue:rgb}}
ForegroundNegative={{red:rgb}}
ForegroundNeutral={{yellow:rgb}}
ForegroundNormal={{text:rgb}}
ForegroundPositive={{green:rgb}}
ForegroundVisited={{mauve:rgb}}

# Areas with an inverted look (e.g. some Plasma popups).
[Colors:Complementary]
BackgroundAlternate={{mantle:rgb}}
BackgroundNormal={{crust:rgb}}
DecorationFocus={{accent:rgb}}
DecorationHover={{accent:rgb}}
ForegroundActive={{accent:rgb}}
ForegroundInactive={{subtext0:rgb}}
ForegroundLink={{blue:rgb}}
ForegroundNegative={{red:rgb}}
ForegroundNeutral={{yellow:rgb}}
ForegroundNormal={{text:rgb}}
ForegroundPositive={{green:rgb}}
ForegroundVisited={{mauve:rgb}}

# Title bars and toolbars of focused windows.
[Colors:Header]
BackgroundAlternate={{mantle:rgb}}
BackgroundNormal={{crust:rgb}}
DecorationFocus={{accent:rgb}}
DecorationHover={{accent:rgb}}
ForegroundActive={{accent:rgb}}
ForegroundInactive={{subtext0:rgb}}
ForegroundLink={{blue:rgb}}
ForegroundNegative={{red:rgb}}
ForegroundNeutral={{yellow:rgb}}
ForegroundNormal={{text:rgb}}
ForegroundPositive={{green:rgb}}
ForegroundVisited={{mauve:rgb}}

# Title bars and toolbars of unfocused windows: same surface, dimmer text.
[Colors:Header][Inactive]
BackgroundAlternate={{mantle:rgb}}
BackgroundNormal={{crust:rgb}}
DecorationFocus={{accent:rgb}}
DecorationHover={{accent:rgb}}
ForegroundActive={{accent:rgb}}
ForegroundInactive={{overlay1:rgb}}
ForegroundLink={{blue:rgb}}
ForegroundNegative={{red:rgb}}
ForegroundNeutral={{yellow:rgb}}
ForegroundNormal={{subtext0:rgb}}
ForegroundPositive={{green:rgb}}
ForegroundVisited={{mauve:rgb}}

# Selected items: text in the base colour on the accent.
[Colors:Selection]
BackgroundAlternate={{mix(accent,base,0.3):rgb}}
BackgroundNormal={{accent:rgb}}
DecorationFocus={{accent:rgb}}
DecorationHover={{accent:rgb}}
ForegroundActive={{base:rgb}}
ForegroundInactive={{mix(base,accent,0.25):rgb}}
ForegroundLink={{base:rgb}}
ForegroundNegative={{red:rgb}}
ForegroundNeutral={{yellow:rgb}}
ForegroundNormal={{base:rgb}}
ForegroundPositive={{green:rgb}}
ForegroundVisited={{base:rgb}}

[Colors:Tooltip]
BackgroundAlternate={{mantle:rgb}}
BackgroundNormal={{crust:rgb}}
DecorationFocus={{accent:rgb}}
DecorationHover={{accent:rgb}}
ForegroundActive={{accent:rgb}}
ForegroundInactive={{subtext0:rgb}}
ForegroundLink={{blue:rgb}}
ForegroundNegative={{red:rgb}}
ForegroundNeutral={{yellow:rgb}}
ForegroundNormal={{text:rgb}}
ForegroundPositive={{green:rgb}}
ForegroundVisited={{mauve:rgb}}

# Content areas: lists, text fields, documents.
[Colors:View]
BackgroundAlternate={{mantle:rgb}}
BackgroundNormal={{base:rgb}}
DecorationFocus={{accent:rgb}}
DecorationHover={{accent:rgb}}
ForegroundActive={{accent:rgb}}
ForegroundInactive={{subtext0:rgb}}
ForegroundLink={{blue:rgb}}
ForegroundNegative={{red:rgb}}
ForegroundNeutral={{yellow:rgb}}
ForegroundNormal={{text:rgb}}
ForegroundPositive={{green:rgb}}
ForegroundVisited={{mauve:rgb}}

# Window backgrounds, around the content.
[Colors:Window]
BackgroundAlternate={{crust:rgb}}
BackgroundNormal={{mantle:rgb}}
DecorationFocus={{accent:rgb}}
DecorationHover={{accent:rgb}}
ForegroundActive={{accent:rgb}}
ForegroundInactive={{subtext0:rgb}}
ForegroundLink={{blue:rgb}}
ForegroundNegative={{red:rgb}}
ForegroundNeutral={{yellow:rgb}}
ForegroundNormal={{text:rgb}}
ForegroundPositive={{green:rgb}}
ForegroundVisited={{mauve:rgb}}

[General]
ColorScheme={{scheme}}
Name=kome: {{name}}
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={{crust:rgb}}
activeBlend={{text:rgb}}
activeForeground={{text:rgb}}
inactiveBackground={{crust:rgb}}
inactiveBlend={{subtext0:rgb}}
inactiveForeground={{subtext0:rgb}}
