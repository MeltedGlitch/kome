/**
 * @name kome
 * @description {{name}}, generated by kome — do not edit this file.
 * @version 1
 */

/*
 * To customise it, copy this template to
 *   ~/.config/kome/templates/vesktop/kome.theme.css.in
 * and edit the copy. Variables and role choices follow Catppuccin's
 * Discord theme (MIT); Discord renames its variables from time to time.
 */

.visual-refresh.theme-dark,
.visual-refresh .theme-dark,
.visual-refresh.theme-light,
.visual-refresh .theme-light {
  --brand-500: {{accent}} !important;
  --brand-560: {{darken(accent,0.1)}};
  --text-brand: {{accent}};
  --blurple-50: {{accent}};

  --__header-bar-background: {{mantle}} !important;
  --app-frame-background: {{crust}};

  --text-default: {{text}};
  --text-strong: {{text}} !important;
  --text-subtle: {{subtext1}};
  --text-muted: {{subtext0}} !important;
  --text-link: {{blue}} !important;
  --text-feedback-positive: {{green}};
  --text-feedback-critical: {{red}};
  --text-feedback-warning: {{yellow}};
  --text-feedback-info: {{blue}};

  --background-base-lowest: {{crust}} !important;
  --background-base-lower: {{mantle}} !important;
  --background-base-low: {{mix(base,mantle,0.2)}} !important;
  --background-surface-high: {{base}} !important;
  --background-surface-higher: {{mix(surface0,base,0.2)}} !important;
  --background-surface-highest: {{surface0}} !important;
  --background-secondary-alt: {{mix(base,mantle,0.2)}} !important;
  --background-accent: {{surface1}} !important;
  --bg-surface-raised: {{mantle}};
  --home-background: {{base}};
  --chat-background: {{base}};
  --chat-background-default: {{base}};
  --chat-border: {{crust}};
  --channeltextarea-background: {{mantle}};
  --modal-background: {{base}} !important;
  --modal-footer-background: {{base}};
  --card-background-default: {{surface0}} !important;
  --custom-channel-members-bg: {{mantle}};
  --user-profile-overlay-background: {{mantle}};
  --user-profile-overlay-background-hover: {{surface0}};

  --border-subtle: {{base}} !important;
  --border-muted: {{surface0}};
  --border-normal: {{crust}};
  --border-strong: {{mantle}};

  --background-mod-subtle: rgba({{surface2:rgb}},0.25) !important;
  --background-mod-normal: rgba({{surface2:rgb}},0.15);
  --background-mod-muted: rgba({{surface2:rgb}},0.05);
  --background-mod-strong: rgba({{surface2:rgb}},0.45) !important;

  --interactive-icon-default: {{text}} !important;
  --interactive-icon-hover: {{text}};
  --interactive-icon-active: {{text}};
  --interactive-text-default: {{text}} !important;
  --interactive-text-hover: {{text}};
  --interactive-text-active: {{text}};
  --interactive-muted: {{overlay0}};
  --interactive-background-hover: rgba({{overlay2:rgb}},0.15);
  --interactive-background-selected: rgba({{overlay0:rgb}},0.2);
  --interactive-background-active: rgba({{text:rgb}},0.17);

  --channels-default: {{subtext0}} !important;
  --channel-icon: {{subtext0}} !important;
  --icon-default: {{text}};
  --icon-strong: {{text}};
  --icon-subtle: {{subtext1}};
  --icon-muted: {{subtext0}} !important;

  --control-primary-background-default: {{accent}};
  --control-primary-background-hover: {{darken(accent,0.08)}};
  --control-primary-background-active: {{darken(accent,0.12)}};
  --control-secondary-background-default: {{surface1}} !important;
  --control-secondary-background-hover: {{darken(surface1,0.05)}};
  --control-secondary-background-active: {{darken(surface1,0.08)}};
  --control-secondary-text-default: {{text}} !important;
  --control-brand-foreground: {{accent}};
  --control-brand-foreground-new: {{accent}};

  --input-background-default: {{crust}};
  --input-text-default: {{text}};
  --input-placeholder-text-default: {{subtext1}};
  --input-border-default: {{overlay0}};

  --mention-foreground: {{accent}};
  --mention-background: rgba({{accent:rgb}},0.3);
  --message-reacted-text-default: {{accent}};
  --message-reacted-background-default: rgba({{accent:rgb}},0.3) !important;
  --message-mentioned-background-default: rgba({{yellow:rgb}},0.1);
  --message-mentioned-background-hover: rgba({{yellow:rgb}},0.08);
  --message-background-hover: rgba({{crust:rgb}},0.3) !important;
  --message-highlight-background-default: rgba({{accent:rgb}},0.08);
  --message-highlight-background-hover: rgba({{accent:rgb}},0.06);

  --scrollbar-thin-thumb: {{accent}};
  --scrollbar-thin-track: transparent;
  --scrollbar-auto-thumb: {{accent}};
  --scrollbar-auto-track: {{crust}};

  --status-positive: {{green}};
  --status-warning: {{yellow}};
  --status-danger: {{red}};
  --text-status-online: {{green}};
  --text-status-idle: {{yellow}};
  --text-status-dnd: {{red}};
  --text-status-offline: {{subtext1}};
  --icon-status-online: {{green}};
  --icon-status-idle: {{yellow}};
  --icon-status-dnd: {{red}};
  --icon-status-offline: {{subtext1}};
  --badge-notification-background: {{red}};
  --badge-text-brand: {{base}};

  --spoiler-revealed-background: {{surface0}};
  --spoiler-hidden-background: {{surface2}};
  --background-code: {{mantle}};
  --textbox-markdown-syntax: {{overlay0}};
  --__adaptive-focus-ring-color: {{accent}};
}

::selection {
  background-color: rgba({{accent:rgb}},0.6);
}
