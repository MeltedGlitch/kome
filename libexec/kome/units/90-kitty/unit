#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# kitty — the kitty terminal's colours (an integration). kitty reads
# kome-theme.conf through `include kome-theme.conf` in kitty.conf, and
# reloads on SIGUSR1. The mechanics are in lib/kome/themefile.sh.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
KOME_ROOT=${KOME_ROOT:-$(CDPATH='' cd -- "$here/../../../.." && pwd)}
KOME_PROG="kome: kitty"
# shellcheck source=lib/kome/common.sh
. "$KOME_ROOT/lib/kome/common.sh"
# shellcheck source=lib/kome/preset.sh
. "$KOME_ROOT/lib/kome/preset.sh"
# shellcheck source=lib/kome/themefile.sh
. "$KOME_ROOT/lib/kome/themefile.sh"

# shellcheck disable=SC2034 # read by themefile.sh
{
	dir=${KITTY_CONFIG_DIRECTORY:-${XDG_CONFIG_HOME:-$HOME/.config}/kitty}
	tf_app=kitty
	tf_title=kitty
	tf_conf=$dir/kitty.conf
	tf_theme=$dir/kome-theme.conf
	tf_include='include kome-theme.conf'
	tf_template=kitty-theme.conf.in
	tf_signal=USR1
}

themefile_main "$@"
