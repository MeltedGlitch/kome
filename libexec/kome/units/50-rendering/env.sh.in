# Generated by kome (rendering unit) — do not edit this file.
# Plasma sources it at login (with or without systemd). To customise it,
# copy this template to ~/.config/kome/templates/rendering/env.sh.in.
#
# FreeType stem darkening emboldens thin stems slightly, as macOS does;
# without it text on Linux looks thin and washed out.
export FREETYPE_PROPERTIES="cff:no-stem-darkening=0 autofitter:no-stem-darkening=0"
