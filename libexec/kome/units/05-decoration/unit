#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# decoration — the window decoration: the engine KWin draws windows with,
# the corner radius, and the title bar buttons.
#
# The style says it in generic words (decoration=klassy|breeze,
# window_radius, window_buttons=circles|icons, buttons_left/right in KWin's
# letters: M menu, S all desktops, H help, I minimise, A maximise, X close);
# only this unit knows how Klassy spells them. Klassy is an optional
# ingredient: without it the windows keep their frame, with a notice. The
# frame's colours come from the colour scheme (the colors unit); only the
# circle buttons get their own, from the palette (button-colors.in, through
# Klassy's per-button colour overrides). Empty values mean KDE's default
# (the key is deleted).
#
# It runs first (05): applying the colour scheme makes KWin reload every
# decoration, and that reload must already find Klassy's new settings —
# when decoration ran after colors, KWin could reload with the old ones
# (found live: circles showed as bare icons until the next apply).

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
KOME_ROOT=${KOME_ROOT:-$(CDPATH='' cd -- "$here/../../../.." && pwd)}
KOME_PROG="kome: decoration"
# shellcheck source=lib/kome/common.sh
. "$KOME_ROOT/lib/kome/common.sh"
# shellcheck source=lib/kome/preset.sh
. "$KOME_ROOT/lib/kome/preset.sh"
# shellcheck source=lib/kome/keys.sh
. "$KOME_ROOT/lib/kome/keys.sh"

# Every key this unit owns: "<state name>:<file>:<group>:<key>".
KEYS="library:kwinrc:org.kde.kdecoration2:library
theme:kwinrc:org.kde.kdecoration2:theme
buttons_left:kwinrc:org.kde.kdecoration2:ButtonsOnLeft
buttons_right:kwinrc:org.kde.kdecoration2:ButtonsOnRight
radius:klassy/klassyrc:Windeco:WindowCornerRadius
shape:klassy/klassyrc:Windeco:ButtonShape
background:klassy/klassyrc:ButtonColors:ButtonBackgroundColorsActive
background_inactive:klassy/klassyrc:ButtonColors:ButtonBackgroundColorsInactive
opacity:klassy/klassyrc:ButtonColors:ButtonBackgroundOpacityActive
opacity_inactive:klassy/klassyrc:ButtonColors:ButtonBackgroundOpacityInactive
close_hover:klassy/klassyrc:ButtonColors:NegativeCloseBackgroundHoverPressActive
close_hover_inactive:klassy/klassyrc:ButtonColors:NegativeCloseBackgroundHoverPressInactive
show_bg:klassy/klassyrc:ButtonBehaviour:ShowBackgroundNormallyActive
show_bg_inactive:klassy/klassyrc:ButtonBehaviour:ShowBackgroundNormallyInactive
show_close_bg:klassy/klassyrc:ButtonBehaviour:ShowCloseBackgroundNormallyActive
show_close_bg_inactive:klassy/klassyrc:ButtonBehaviour:ShowCloseBackgroundNormallyInactive
show_icon:klassy/klassyrc:ButtonBehaviour:ShowIconNormallyActive
show_icon_inactive:klassy/klassyrc:ButtonBehaviour:ShowIconNormallyInactive
show_close_icon:klassy/klassyrc:ButtonBehaviour:ShowCloseIconNormallyActive
show_close_icon_inactive:klassy/klassyrc:ButtonBehaviour:ShowCloseIconNormallyInactive
poor_contrast:klassy/klassyrc:ButtonColors:OnPoorIconContrastActive
poor_contrast_inactive:klassy/klassyrc:ButtonColors:OnPoorIconContrastInactive
minimize:klassy/klassyrc:ButtonColors:ButtonOverrideColorsActiveMinimize
maximize:klassy/klassyrc:ButtonColors:ButtonOverrideColorsActiveMaximize
close:klassy/klassyrc:ButtonColors:ButtonOverrideColorsActiveClose
minimize_inactive:klassy/klassyrc:ButtonColors:ButtonOverrideColorsInactiveMinimize
maximize_inactive:klassy/klassyrc:ButtonColors:ButtonOverrideColorsInactiveMaximize
close_inactive:klassy/klassyrc:ButtonColors:ButtonOverrideColorsInactiveClose"

# buttons_as <shape> <colours> <background always shown> <icon always shown>
# Klassy shows a button's background only on hover by default, so every
# visibility key is set explicitly, for active and inactive windows: that
# way switching between button styles works from any previous klassyrc.
# Inactive windows get dimmer backgrounds; close turns red on hover.
buttons_as() {
	key_set shape "$1"
	for _s in '' _inactive; do
		key_set "background$_s" "$2"
		key_set "show_bg$_s" "$3"
		key_set "show_close_bg$_s" "$3"
		key_set "show_icon$_s" "$4"
		key_set "show_close_icon$_s" "$4"
		key_set "close_hover$_s" true
	done
	key_set opacity 100
	key_set opacity_inactive 50
}

# button_colors on|off — the circles' own colours from button-colors.in
# (Klassy's per-button overrides), or none (Klassy's colours). With them,
# Klassy must not swap a soft symbol for black or white on "poor contrast".
OVERRIDES="minimize maximize close minimize_inactive maximize_inactive close_inactive"
button_colors() {
	if [ "$1" = off ]; then
		for _b in $OVERRIDES poor_contrast poor_contrast_inactive; do key_set "$_b" ''; done
		return 0
	fi
	_template=$(template_find decoration button-colors.in)
	_colors=$(template_fill "$_template") ||
		die "$EX_DATAERR" "could not fill $_template" "fix the template, or delete your copy of it"
	for _b in $OVERRIDES; do
		_line=$(printf '%s\n' "$_colors" | grep "^$_b=" | tail -n 1) ||
			die "$EX_DATAERR" "$_template has no '$_b=' line" "fix the template, or delete your copy of it"
		key_set "$_b" "${_line#*=}"
	done
	key_set poor_contrast Nothing
	key_set poor_contrast_inactive Nothing
}

do_check() {
	need_tools kreadconfig6 kwriteconfig6
	case ${KOME_DECORATION-} in
	'' | breeze) ;;
	klassy)
		if ! command -v klassy-settings >/dev/null 2>&1; then
			printf 'decoration:Klassy\n'
			exit "$CHECK_OPTIONAL"
		fi
		;;
	*)
		err "decoration=$KOME_DECORATION is not known (use klassy or breeze)"
		hint "fix decoration= in the style, or remove it to keep your windows as they are"
		exit "$CHECK_ERROR"
		;;
	esac
	case ${KOME_WINDOW_BUTTONS-} in
	'' | circles | icons) ;;
	*)
		err "window_buttons=$KOME_WINDOW_BUTTONS is not known (use circles or icons)"
		hint "fix window_buttons= in the style"
		exit "$CHECK_ERROR"
		;;
	esac
	exit "$CHECK_READY"
}

do_apply() {
	case ${KOME_DECORATION-} in
	'') return 0 ;;
	breeze)
		key_set library org.kde.breeze
		key_set theme Breeze
		;;
	klassy)
		key_set library org.kde.klassy
		key_set theme Klassy
		key_set radius "${KOME_WINDOW_RADIUS-}"
		case ${KOME_WINDOW_BUTTONS-} in
		circles)
			buttons_as ShapeSmallCircle Accent true true
			button_colors on
			;;
		icons)
			buttons_as ShapeIntegratedRoundedRectangle TitleBarTextNegativeClose false true
			button_colors off
			;;
		esac
		;;
	esac
	key_set buttons_left "${KOME_BUTTONS_LEFT-}"
	key_set buttons_right "${KOME_BUTTONS_RIGHT-}"
	kwin_reconfigure
}

usage() {
	cat <<EOF
usage: unit check | apply | current | restore

  check    exit 0 if the decoration can be set (4: Klassy is not installed)
  apply    set the decoration, corners and buttons from the KOME_* values
  current  print every decoration key kome owns, as name=value
  restore  set the values printed by 'current', read from stdin
EOF
}

case ${1-} in
check) do_check ;;
apply) do_apply ;;
current) keys_current ;;
restore) keys_restore && kwin_reconfigure ;;
-h | --help) usage ;;
*)
	usage >&2
	exit "$EX_USAGE"
	;;
esac
