# Colours of the circle buttons (window_buttons=circles), from the palette.
# Generated by kome into Klassy's per-button colour overrides.
# To customise them, copy this file to
#   ~/.config/kome/templates/decoration/button-colors.in
# and edit the copy. Each line is <button>=<Klassy JSON>, colours as r,g,b.
#
# The circles are the accent colour; the symbols are always shown, in the
# same colour pulled towards the window background (darker on dark looks,
# lighter on light ones): visible without shouting. Hover only dims the
# circle; close turns towards red. Inactive windows are dimmer.

minimize={"BackgroundNormal":[{{accent:rgb}}],"BackgroundHover":[{{mix(accent,base,0.1):rgb}}],"BackgroundPress":[{{mix(accent,base,0.2):rgb}}],"IconNormal":[{{mix(accent,base,0.5):rgb}}],"IconHover":[{{mix(accent,base,0.6):rgb}}],"IconPress":[{{mix(accent,base,0.6):rgb}}]}
maximize={"BackgroundNormal":[{{accent:rgb}}],"BackgroundHover":[{{mix(accent,base,0.1):rgb}}],"BackgroundPress":[{{mix(accent,base,0.2):rgb}}],"IconNormal":[{{mix(accent,base,0.5):rgb}}],"IconHover":[{{mix(accent,base,0.6):rgb}}],"IconPress":[{{mix(accent,base,0.6):rgb}}]}
close={"BackgroundNormal":[{{accent:rgb}}],"BackgroundHover":[{{mix(accent,red,0.7):rgb}}],"BackgroundPress":[{{mix(accent,red,0.85):rgb}}],"IconNormal":[{{mix(accent,base,0.5):rgb}}],"IconHover":[{{mix(red,base,0.55):rgb}}],"IconPress":[{{mix(red,base,0.55):rgb}}]}
minimize_inactive={"BackgroundNormal":[{{mix(accent,base,0.5):rgb}}],"BackgroundHover":[{{mix(accent,base,0.4):rgb}}],"BackgroundPress":[{{mix(accent,base,0.5):rgb}}],"IconNormal":[{{mix(accent,base,0.75):rgb}}],"IconHover":[{{mix(accent,base,0.75):rgb}}],"IconPress":[{{mix(accent,base,0.75):rgb}}]}
maximize_inactive={"BackgroundNormal":[{{mix(accent,base,0.5):rgb}}],"BackgroundHover":[{{mix(accent,base,0.4):rgb}}],"BackgroundPress":[{{mix(accent,base,0.5):rgb}}],"IconNormal":[{{mix(accent,base,0.75):rgb}}],"IconHover":[{{mix(accent,base,0.75):rgb}}],"IconPress":[{{mix(accent,base,0.75):rgb}}]}
close_inactive={"BackgroundNormal":[{{mix(accent,base,0.5):rgb}}],"BackgroundHover":[{{mix(accent,red,0.5):rgb}}],"BackgroundPress":[{{mix(accent,red,0.6):rgb}}],"IconNormal":[{{mix(accent,base,0.75):rgb}}],"IconHover":[{{mix(red,base,0.6):rgb}}],"IconPress":[{{mix(red,base,0.6):rgb}}]}
