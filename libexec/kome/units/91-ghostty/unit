#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# ghostty — the Ghostty terminal's colours (an integration). Ghostty reads
# kome-theme through `config-file = ?kome-theme` in its config (the ? makes a
# missing file harmless), and reloads on SIGUSR2. The mechanics are in
# lib/kome/themefile.sh.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
KOME_ROOT=${KOME_ROOT:-$(CDPATH='' cd -- "$here/../../../.." && pwd)}
KOME_PROG="kome: ghostty"
# shellcheck source=lib/kome/common.sh
. "$KOME_ROOT/lib/kome/common.sh"
# shellcheck source=lib/kome/preset.sh
. "$KOME_ROOT/lib/kome/preset.sh"
# shellcheck source=lib/kome/themefile.sh
. "$KOME_ROOT/lib/kome/themefile.sh"

# shellcheck disable=SC2034 # read by themefile.sh
{
	dir=${XDG_CONFIG_HOME:-$HOME/.config}/ghostty
	tf_app=ghostty
	tf_title=Ghostty
	# Ghostty reads config.ghostty (1.2.3+) and config; use whichever exists.
	if [ -f "$dir/config.ghostty" ]; then
		tf_conf=$dir/config.ghostty
	else
		tf_conf=$dir/config
	fi
	tf_theme=$dir/kome-theme
	tf_include='config-file = ?kome-theme'
	tf_template=ghostty-theme.in
	tf_signal=USR2
}

themefile_main "$@"
