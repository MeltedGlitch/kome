# Generated by kome from the "{{name}}" palette — do not edit this file.
# Ghostty reads it through one line in its config: config-file = ?kome-theme
# To customise it, copy this template to
#   ~/.config/kome/templates/ghostty/ghostty-theme.in
# and edit the copy. Only colours: fonts and the rest stay yours.

background = {{base}}
foreground = {{text}}
cursor-color = {{rosewater}}
cursor-text = {{base}}
selection-background = {{surface2}}
selection-foreground = {{text}}

# The 16 terminal colours. "Black" and "white" swap for light looks.
palette = 0={{by_mode(surface1,subtext1)}}
palette = 1={{red}}
palette = 2={{green}}
palette = 3={{yellow}}
palette = 4={{blue}}
palette = 5={{pink}}
palette = 6={{teal}}
palette = 7={{by_mode(subtext1,surface2)}}
palette = 8={{by_mode(surface2,subtext0)}}
palette = 9={{red}}
palette = 10={{green}}
palette = 11={{yellow}}
palette = 12={{blue}}
palette = 13={{pink}}
palette = 14={{teal}}
palette = 15={{by_mode(subtext0,surface1)}}
