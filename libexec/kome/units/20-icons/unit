#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# icons — the icon theme, with folders in the preset's accent colour.
#
# apply: with only KOME_ICON_THEME, sets that theme. With KOME_ICON_ACCENT
# too, generates a small theme in $XDG_DATA_HOME/icons/ that inherits from
# it and only overrides folder icons with the accent's (the same rule as
# papirus-folders: folder-<accent>[-x].svg and user-<accent>[-x].svg become
# folder[-x].svg and user[-x].svg). The original theme is never modified,
# so no root is needed. Like colors, each preset alternates between
# kome-<preset>-A and -B and never rewrites the active theme.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
KOME_ROOT=${KOME_ROOT:-$(CDPATH='' cd -- "$here/../../../.." && pwd)}
KOME_PROG="kome: icons"
# shellcheck source=lib/kome/common.sh
. "$KOME_ROOT/lib/kome/common.sh"

user_icons=${XDG_DATA_HOME:-$HOME/.local/share}/icons

# Raw value: empty when the user never set it (KDE's default applies).
current_theme() {
	kreadconfig6 --file kdeglobals --group Icons --key Theme
}

# theme_dir <theme> — print the directory of an installed icon theme.
theme_dir() {
	_IFS=$IFS
	IFS=:
	for _d in "$HOME/.icons" "$user_icons" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
		case $_d in
		*/icons | "$HOME/.icons") ;;
		*) _d=$_d/icons ;;
		esac
		if [ -f "$_d/$1/index.theme" ]; then
			IFS=$_IFS
			printf '%s\n' "$_d/$1"
			return 0
		fi
	done
	IFS=$_IFS
	return 1
}

# folder_source <theme> <accent> — print the dir of the first theme in the
# Inherits chain that has real (non-symlink) folder-<accent>.svg files.
folder_source() {
	_queue=$1
	_seen=
	while [ -n "$_queue" ]; do
		_t=${_queue%%,*}
		case $_queue in *,*) _queue=${_queue#*,} ;; *) _queue= ;; esac
		case ",$_seen," in *",$_t,"*) continue ;; esac
		_seen="$_seen,$_t"
		_dir=$(theme_dir "$_t") || continue
		for _f in "$_dir"/*/places/folder-"$2".svg; do
			if [ -f "$_f" ] && [ ! -L "$_f" ]; then
				printf '%s\n' "$_dir"
				return 0
			fi
		done
		_inh=$(sed -n 's/^Inherits=//p' "$_dir/index.theme" | head -n 1)
		[ -z "$_inh" ] || _queue=${_queue:+$_queue,}$_inh
	done
	return 1
}

set_theme() {
	if [ -z "$1" ]; then
		kwriteconfig6 --file kdeglobals --group Icons --key Theme --delete
	else
		kwriteconfig6 --file kdeglobals --group Icons --key Theme "$1"
	fi
	# Tell running KDE apps the icons changed, as System Settings does: one
	# KIconLoader signal per icon group (Desktop, Toolbar, MainToolbar, Small,
	# Panel, Dialog) — with only group 0, the panel kept its old icons until
	# hovered — plus KGlobalSettings' IconChanged (4).
	for _group in 0 1 2 3 4 5; do
		dbus-send --session --type=signal /KIconLoader \
			org.kde.KIconLoader.iconChanged "int32:$_group" 2>/dev/null || :
	done
	dbus-send --session --type=signal /KGlobalSettings \
		org.kde.KGlobalSettings.notifyChange int32:4 int32:0 2>/dev/null || :
}

do_check() {
	for _tool in kreadconfig6 kwriteconfig6; do
		if ! command -v "$_tool" >/dev/null 2>&1; then
			err "$_tool not found: this needs KDE Plasma 6"
			hint "run 'kome doctor' on a Plasma 6 session"
			exit 3
		fi
	done
	[ -n "${KOME_ICON_THEME-}" ] || exit 0
	if ! theme_dir "$KOME_ICON_THEME" >/dev/null; then
		printf 'icons:%s\n' "$KOME_ICON_THEME"
		exit 2
	fi
	if [ -n "${KOME_ICON_ACCENT-}" ] && ! folder_source "$KOME_ICON_THEME" "$KOME_ICON_ACCENT" >/dev/null; then
		err "the icon theme '$KOME_ICON_THEME' has no '$KOME_ICON_ACCENT' folders"
		hint "set icon_accent= in the preset to a colour it has (e.g. blue, violet, teal), or remove it"
		exit 3
	fi
	exit 0
}

# derive <name> <base> <accent> — write the folder-colour theme.
derive() {
	_src=$(folder_source "$2" "$3")
	_out=$user_icons/$1
	_tmp=$user_icons/.$1.kome-tmp
	rm -rf "$_tmp"
	mkdir -p "$_tmp"
	_dirs=
	for _f in "$_src"/*/places/folder-"$3"*.svg "$_src"/*/places/user-"$3"*.svg; do
		if [ ! -f "$_f" ] || [ -L "$_f" ]; then
			continue
		fi
		_rel=${_f#"$_src"/}
		_sub=${_rel%/*}
		_base=${_rel##*/}
		_plain=$(printf '%s' "$_base" | sed "s/-$3\(-\|\.svg\)/\1/")
		mkdir -p "$_tmp/$_sub"
		ln -sf "$_f" "$_tmp/$_sub/$_plain"
		case ",$_dirs," in *",$_sub,"*) ;; *) _dirs=${_dirs:+$_dirs,}$_sub ;; esac
	done
	{
		printf '[Icon Theme]\nName=kome: %s\n' "${KOME_NAME:-$1}"
		printf 'Comment=Generated by kome: %s with %s folders\n' "$2" "$3"
		printf 'Inherits=%s\nDirectories=%s\n' "$2" "$_dirs"
		printf '%s\n' "$_dirs" | tr ',' '\n' | while IFS= read -r _sub; do
			_size=${_sub%%x*}
			case $_sub in
			*@2x/*) _scale=2 ;;
			*) _scale=1 ;;
			esac
			printf '\n[%s]\nContext=Places\nSize=%s\nScale=%s\nType=Fixed\n' "$_sub" "$_size" "$_scale"
		done
	} >"$_tmp/index.theme"
	rm -rf "${user_icons:?}/${1:?}"
	mv "$_tmp" "$_out"
}

do_apply() {
	[ -n "${KOME_ICON_THEME-}" ] || return 0
	if [ -z "${KOME_ICON_ACCENT-}" ]; then
		set_theme "$KOME_ICON_THEME"
		return
	fi
	[ -n "${KOME_PRESET-}" ] ||
		die "$EX_USAGE" "KOME_PRESET is not set" "apply a look with 'kome apply <preset>'"
	_name=kome-$KOME_PRESET-A
	if [ "$(current_theme)" = "$_name" ]; then
		_name=kome-$KOME_PRESET-B
	fi
	derive "$_name" "$KOME_ICON_THEME" "$KOME_ICON_ACCENT"
	manifest_add "$user_icons/$_name"
	set_theme "$_name"
}

do_restore() {
	_theme=
	_found=
	while IFS= read -r _line; do
		case $_line in
		theme=*)
			_theme=${_line#theme=}
			_found=1
			;;
		esac
	done
	[ -n "$_found" ] ||
		die 65 "no 'theme=' line on stdin" "pipe in the output of 'unit current'"
	set_theme "$_theme"
}

usage() {
	cat <<EOF
usage: unit check | apply | current | restore

  check    exit 0 if the icons can be set (2: the icon theme is missing)
  apply    set KOME_ICON_THEME, with KOME_ICON_ACCENT folders if given
  current  print the icon theme as theme=<name> (empty: KDE's default)
  restore  set the theme printed by 'current', read from stdin
EOF
}

case ${1-} in
check) do_check ;;
apply) do_apply ;;
current) printf 'theme=%s\n' "$(current_theme)" ;;
restore) do_restore ;;
-h | --help) usage ;;
*)
	usage >&2
	exit "$EX_USAGE"
	;;
esac
